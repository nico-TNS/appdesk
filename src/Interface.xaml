<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AppDesk — Mon installateur 2.3" Width="1160" Height="800" MinWidth="1020" MinHeight="750" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F4F7FC" FontFamily="Segoe UI" FontSize="13" Foreground="#172641">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#405273"/>
   <Setter Property="BorderBrush" Value="#DCE4F1"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource QuietButton}"/>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Background" Value="#1C2C48"/><Setter Property="Foreground" Value="#D4DFF2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4F1"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,4" Foreground="#8190A8" IsHitTestVisible="False"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#DCE4F1" BorderThickness="1" CornerRadius="6" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AppCard" TargetType="CheckBox">
   <Setter Property="Margin" Value="0,0,12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="82"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Card" Background="White" BorderBrush="#DDE5F1" BorderThickness="1" CornerRadius="11" Padding="12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="11" Background="{Binding Color}" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="10,1,4,0"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#7C8BA3" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#4569C2" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Border x:Name="TickBg" Grid.Column="2" Width="18" Height="18" BorderBrush="#C8D3E5" BorderThickness="1" CornerRadius="5" VerticalAlignment="Top"><TextBlock x:Name="Tick" Text="✓" Visibility="Hidden" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#426AEC"/><Setter TargetName="Card" Property="Background" Value="#F0F4FF"/><Setter TargetName="TickBg" Property="Background" Value="#426AEC"/><Setter TargetName="TickBg" Property="BorderBrush" Value="#426AEC"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8AA4EF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#CCD6E6" BorderThickness="1">
 <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="White"><TextBlock Text="AppDesk  /  Mon installateur" Margin="18,0" FontSize="11" Foreground="#8290A6" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" Content="—" Width="42" Padding="0" BorderThickness="0"/><Button x:Name="CloseWindow" Content="✕" Width="42" Padding="0" BorderThickness="0"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#13223D"><Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Border Width="42" Height="42" CornerRadius="12" Background="#4F75F5" HorizontalAlignment="Left"><TextBlock Text="↓" Foreground="White" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="AppDesk" FontSize="23" Foreground="White" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock Text="Votre poste,&#10;prêt à travailler." Foreground="#9DACC6" FontSize="13" LineHeight="21" Margin="0,8,0,30"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="CATALOGUE" Foreground="#7387A8" FontSize="10" FontWeight="Bold" Margin="3,0,0,13"/><Button x:Name="NavAll" Content="Toutes les apps" Style="{StaticResource NavButton}" Background="#345EDC" Foreground="White"/><Button x:Name="NavWeb" Content="Navigateurs" Style="{StaticResource NavButton}"/><Button x:Name="NavVpn" Content="VPN et accès" Style="{StaticResource NavButton}"/><Button x:Name="NavWork" Content="Bureautique" Style="{StaticResource NavButton}"/></StackPanel>
    <StackPanel Grid.Row="3"><Button x:Name="ShowReport" Content="Rapport d’installation" Style="{StaticResource NavButton}" Visibility="Collapsed"/><Border Background="#1D3152" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="Une seule fenêtre" Foreground="#DCE6F8" FontWeight="SemiBold"/><TextBlock Text="Téléchargements vérifiés&#10;Installation en arrière-plan" Foreground="#96ABCE" FontSize="11" Margin="0,6,0,0" LineHeight="18"/></StackPanel></Border><TextBlock Text="VERSION 2.3  ·  WINDOWS 10 / 11" Foreground="#7084A6" FontSize="9" Margin="2,20,0,0"/></StackPanel>
   </Grid></Border>
   <Grid x:Name="CatalogPanel" Grid.Column="1" Margin="30,24,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,12,22"><StackPanel><TextBlock Text="Préparez votre PC." FontSize="28" FontWeight="Bold"/><TextBlock Text="Choisissez vos applications. AppDesk s’occupe de l’installation." Foreground="#7C8BA3" Margin="0,7,0,0"/></StackPanel><Border Background="#E3F2ED" CornerRadius="12" Padding="11,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"><TextBlock Text="●  Mode silencieux" Foreground="#237E63" FontSize="11"/></Border></Grid>
    <Grid Grid.Row="1" Margin="0,0,12,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#DCE4F1" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0"><DockPanel><TextBlock Text="⌕" Foreground="#8E9CB1" Margin="0,0,9,0" FontSize="16"/><TextBox x:Name="Search" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" ToolTip="Rechercher une application"/></DockPanel></Border><Button x:Name="SelectAll" Grid.Column="1" Content="Tout sélectionner" Margin="0,0,8,0"/><Button x:Name="ClearAll" Grid.Column="2" Content="Effacer"/></Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"><ItemsControl x:Name="Cards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppCard}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel Grid.Row="3" Margin="0,0,12,16">
     <Border Background="White" BorderBrush="#E0E7F2" BorderThickness="1" CornerRadius="9" Padding="13,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Édition Office" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/><ComboBox x:Name="OfficeEdition" Grid.Column="1" Height="29"/><TextBlock Grid.Column="2" Text="64 bits · Français" Foreground="#8593A9" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
     <DockPanel Margin="0,8,0,0"><Button x:Name="UninstallOffice" DockPanel.Dock="Right" Content="Office Removal — Office + OneNote…" Foreground="#B43A49" FontSize="11" Padding="11,6" ToolTip="Retirer la suite Office détectée avec une confirmation distincte"/><TextBlock Text="Changer d’édition ? Retirez d’abord la suite Office actuelle." FontSize="11" Foreground="#7C8BA3" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="UpdateExisting" Content="Mettre aussi à jour les applications présentes" IsChecked="True" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AutoForti" Content="Automatique" FontSize="11" Padding="10,5" Margin="0,0,6,0" ToolTip="Dernière version FortiClient VPN du portail officiel"/><Button x:Name="ChooseForti" Content="Package manuel…" FontSize="11" Padding="10,5" ToolTip="Remplacer le téléchargement FortiClient par un package officiel local"/></StackPanel></Grid>
     <TextBlock x:Name="FortiHint" Text="Versions résolues en ligne · FortiClient VPN : portail officiel régional Fortinet, signature vérifiée." TextWrapping="Wrap" Foreground="#687A97" FontSize="10" Margin="0,7,0,0"/>
    </StackPanel>
    <Border Grid.Row="4" Background="White" BorderBrush="#DBE4F2" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,12,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock x:Name="ProgressTitle" Text="Prêt quand vous l’êtes." FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="Completed" Text="0 application sélectionnée" HorizontalAlignment="Right" Foreground="#7C8BA3" FontSize="11" VerticalAlignment="Center"/></Grid>
      <ProgressBar x:Name="Overall" Grid.Row="1" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,12,0,0" BorderThickness="0" Background="#EBEFF7" Foreground="#4169EA"/>
      <Grid Grid.Row="2" Margin="0,9,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock x:Name="Activity" Text="Aucune installation ne démarre avant votre confirmation." FontSize="11" Foreground="#8290A7" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ActivityBar" Grid.Column="1" Height="4" Visibility="Collapsed" Maximum="100" Foreground="#7C98F0" Background="#EDF1F9"/></Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><CheckBox x:Name="Consent" Content="J’accepte les licences des applications sélectionnées." FontSize="11"/><TextBlock Foreground="#9AA6B9" FontSize="10" Margin="0,6,0,0"><Run Text="Office : licence requise. Autorisation Windows au démarrage.  "/><Hyperlink x:Name="OpenLogs">Journal</Hyperlink></TextBlock></StackPanel><Button x:Name="Stop" Grid.Column="1" Content="Arrêter après cette app" Margin="8,0" Visibility="Collapsed" FontSize="11"/><Button x:Name="Install" Grid.Column="2" Content="Installer la sélection  →" Background="#4169EA" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Padding="19,13" IsEnabled="False"/></Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="ReportPanel" Grid.Column="1" Margin="30,26,30,24" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="RAPPORT D’INSTALLATION" Foreground="#4A6CCE" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ReportTitle" FontSize="27" FontWeight="Bold" Margin="0,8,0,7" TextWrapping="Wrap"/><TextBlock x:Name="ReportContext" Foreground="#7C8BA3" TextWrapping="Wrap"/></StackPanel>
    <Border Grid.Row="1" Background="#EAF0FD" CornerRadius="10" Padding="16,13" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="ReportSummary" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ReportIssue" Foreground="#C13C4B" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ReportRows"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DFE6F2" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{Binding Color}" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="13,0,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="16,0,0,0"/></Grid><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#536580" Margin="0,7,0,0"/><TextBlock Text="{Binding Code}" Foreground="#8A98AD" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BackToApps" Content="← Retour aux applications" HorizontalAlignment="Left"/><Button x:Name="ReportLogs" Grid.Column="1" Content="Journaux détaillés" Margin="8,0"/><Button x:Name="ExportReport" Grid.Column="2" Content="Exporter le rapport" Background="#4169EA" Foreground="White" BorderThickness="0"/></Grid>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>
